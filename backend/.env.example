# Runtime mode: development | test | production
ENVIRONMENT=development

# PostgreSQL (docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://meshboard:dev_password@localhost:5432/meshboard

# Replace before any non-local deployment. Use at least 32 random characters.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON array of trusted browser origins
CORS_ORIGINS=["http://localhost:5173"]

# ── LLM backend ───────────────────────────────────────────────────────────
# Defaults point at a LOCAL OpenAI-compatible server (Ollama). No API key, no paid calls.
#   1) install Ollama: https://ollama.com/download
#   2) ollama pull qwen3:8b
# Swap in any other OpenAI-compatible backend by changing these three values, e.g.
#   vLLM        LLM_BASE_URL=http://localhost:8000/v1   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#   LM Studio   LLM_BASE_URL=http://localhost:1234/v1   LLM_MODEL=qwen2.5-7b-instruct
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o  LLM_API_KEY=sk-...
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=4096
# Thinking 토큰 예산. Qwen3 등 하이브리드 추론 모델에서 "none" 이면 숨은 추론을 끄고
# 응답만 생성한다(실측 100배 이상 빠름). 추론이 필요한 작업이면 low/medium/high 로 올린다.
LLM_REASONING_EFFORT=none
# Optional JSON map of shorthand -> real model name. Example: {"fast":"qwen3:4b"}
LLM_MODEL_ALIASES={}

# ── Optional external gateway ─────────────────────────────────────────────
# Leave RUNYOUR_API_KEY empty to stay fully local. Filling it switches every agent
# call to the gateway below and WILL incur paid usage.
RUNYOUR_API_KEY=
RUNYOUR_BASE_URL=https://api.runyour.ai/v1
RUNYOUR_MODEL=openai/gpt-5
# Optional JSON rates per one million tokens, keyed by exact model name.
MODEL_PRICING_USD_PER_MILLION={}

# ── Optional narration model (CityLearn board commentary only) ────────────
# Rewrites deterministic agent facts as natural sentences. Off by default;
# when off the board falls back to templates and behaves identically.
MESH_LLM_NARRATION_ENABLED=false
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_API_KEY=ollama
QWEN_MODEL=qwen2.5:7b
QWEN_TIMEOUT_SECONDS=20
QWEN_MAX_CONCURRENCY=8

# Message broker safeguards
AGENT_INVOKE_TIMEOUT_SECONDS=180
AGENT_INVOKE_MAX_CONCURRENCY=4

# JSON array of external tool descriptors
EXTERNAL_MCP_TOOLS=[]

# Optional SIEM/webhook sink for policy violations (HTTPS required in production)
SECURITY_WEBHOOK_URL=
SECURITY_WEBHOOK_SECRET=
SECURITY_WEBHOOK_TIMEOUT_SECONDS=5
